    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
