{
  "name": "comp4020-dynamic-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "pnpm build && oxlint --ignore-path .gitignore && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && oxfmt --check . && vitest run",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "astro": "^7.0.9",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.74.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
