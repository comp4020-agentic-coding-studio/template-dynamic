---
// README.md, rendered: the account of what this app is and what good looks
// like here, published with the app so a visitor reads it without leaving the
// site. spec/readme.test.ts holds this page (or whatever replaces it in a
// stack swap) to serving the whole of README.md; style it however you like.
import * as readme from "../../README.md";
import "../styles.css";

const title = readme.getHeadings().find((h) => h.depth === 1)?.text ?? "README";

// README images are committed to public/ and linked relatively (public/x.png)
// so they render on GitHub; here they're served from the site root.
const html = (await readme.compiledContent()).replace(/(src|href)="public\//g, '$1="/');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Guestbook</a>
      <a href="/readme/">About</a>
    </nav>
    <main set:html={html} />
  </body>
</html>
